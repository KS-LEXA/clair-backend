# ─────────────────────────────────────────────────────────────────────
# CLAIR Backend - 환경변수 템플릿
#
# 사용법:
#   1. 이 파일을 .env로 복사:  cp .env.example .env
#   2. 본인 값으로 채우기 (시크릿 값은 팀 공유 채널 참고)
#   3. .env는 절대 git에 커밋하지 마세요 (이미 .gitignore 처리됨)
# ─────────────────────────────────────────────────────────────────────


# === 데이터베이스 (필수) ===
# brew install mysql 후 root 비번 설정 안 했으면 DB_PASSWORD 비워두기
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clair_db


# === 파일 업로드 (필수, 기본값 사용 권장) ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.docx


# === JWT / 인증 (필수) ===
# SECRET_KEY는 본인이 직접 생성: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256


# === CORS (프론트엔드 origin 허용) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# === clair-ai 마이크로서비스 (분석/채팅 테스트 시만 필요) ===
# clair-ai 서버를 따로 띄워야 동작 (포트 8001). 백엔드만 테스트할 거면 그대로 두세요.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=120
GEMINI_API_KEY=


# === 소셜 로그인 (선택) ===
# 비워두면 해당 프로바이더 비활성화. 사용하려면 각 콘솔에서 OAuth 앱 만들고 키 발급
# 콜백 URI는 본인 OAuth 앱에 정확히 등록되어 있어야 함

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Naver: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/naver/callback

# Kakao: https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback


# === 이메일 발송 (비밀번호 재설정 / 알림 메일 테스트 시 필요) ===
# Gmail 사용 시: 2단계 인증 → 앱 비밀번호 발급 (https://myaccount.google.com/apppasswords)
# 비워두면 메일 발송 시 에러. 메일 기능 안 쓸 거면 빈 채로 둬도 됨.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CLAIR


# === 프론트엔드 페이지 URL (메일 링크 / 공유 링크에 사용) ===
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_PATH=/password-reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30


# === 분석 결과 공유 (PR #18) ===
SHARE_PATH=/share
SHARE_TOKEN_DEFAULT_EXPIRE_DAYS=7
SHARE_ACCESS_TOKEN_EXPIRE_MINUTES=60
